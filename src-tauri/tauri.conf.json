{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PortViewer",
  "version": "1.0.0",
  "identifier": "com.portviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PortViewer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "minimumWebview2Version": "98.0.1108.43",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": false
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "SimpChinese": "windows/languages/SimpChinese.nsh",
          "English": "windows/languages/English.nsh"
        }
      }
    }
  }
}
